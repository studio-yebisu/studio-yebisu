{
  "version": 1,
  "kind": "automation",
  "spec": {
    "name": "架空PRの確認",
    "trigger": {
      "type": "event",
      "source": "github",
      "on": [
        "pull_request.opened",
        "pull_request.labeled"
      ],
      "filter": "action == 'opened'"
    },
    "enabled": false,
    "prompt": "架空の読書会の準備メモを作成してください。未確定の予定は未確定と書き、公開や送信は行わず、下書きとして保存してください。",
    "repository": "https://example.invalid/sakura/bookclub.git",
    "model": null,
    "timeout": 300,
    "branch": "demo",
    "plugins": [],
    "timezone": "Asia/Tokyo"
  }
}
