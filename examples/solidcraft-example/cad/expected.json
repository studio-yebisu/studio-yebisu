    "width": [120.0, 150.0],
    "depth": [80.0, 90.0],
    "height": [18.0, 24.0],
    "hole_diameter": [8.0, 12.0]
  },
  "assumptions": [
    "Ideal hard-edged solid: no fillets, chamfers or drafts. Density is uniform, so the centre of mass is the volume centroid.",
    "The outer block spans x in [-W/2, W/2], y in [-D/2, D/2], z in [0, H]. solid.box length maps to X, width to Y, height to Z (to be confirmed by the bbox at the first inspect).",
    "The pocket is the box (W-2t) x (D-2t) from z=f upward, open at z=H. The cutter extends 1 mm above z=H, so that 1 mm removes nothing.",
    "The hole is the cylinder of radius r=d/2 on the Z axis through the floor, from z=0 to z=f. The cutter runs from z=-1 to z=f+1, and its extra length lies in air.",
    "W=width, D=depth, H=height, d=hole_diameter, r=d/2, t=wall=3, f=floor_thickness=3. Valid while r < min(W,D)/2 - t, which holds over every tested state (r <= 6 < 37).",
    "Logical face counts (block 6, pocket 11, final 12) count the hole bore as one cylindrical face. The checker reports them as advisory only."
  ],
  "formulas": {
    "block": {
      "volume": "W*D*H",
      "area": "2*(W*D + W*H + D*H)",
      "com_z": "H/2"
    },
    "pocket": {
      "volume": "W*D*H - (W-2t)*(D-2t)*(H-f)",
      "area": "2*W*D + 2*(W+D)*H + 2*((W-2t)+(D-2t))*(H-f)",
      "com_z": "[W*D*H*(H/2) - (W-2t)*(D-2t)*(H-f)*((H+f)/2)] / volume"
    },
    "final": {
      "volume": "W*D*H - (W-2t)*(D-2t)*(H-f) - pi*r^2*f",
      "area": "2*W*D + 2*(W+D)*H + 2*((W-2t)+(D-2t))*(H-f) - 2*pi*r^2 + 2*pi*r*f",
      "area_terms": "bottom W*D - pi*r^2; outer sides 2*(W+D)*H; top rim W*D - (W-2t)*(D-2t); inner walls 2*((W-2t)+(D-2t))*(H-f); pocket floor (W-2t)*(D-2t) - pi*r^2; hole bore 2*pi*r*f",
      "com_z": "[W*D*H*(H/2) - (W-2t)*(D-2t)*(H-f)*((H+f)/2) - pi*r^2*f*(f/2)] / volume"
    },
    "com_xy": "x = y = 0: block, pocket and hole are all centred on the Z axis",
    "bbox": "min [-W/2, -D/2, 0], max [W/2, D/2, H]: the rim stays at z=H, so the pocket and hole leave the outer envelope unchanged"
  },
  "tolerances": {
    "volume_rel": 2e-4,
    "area_rel": 2e-4,
    "geometric_abs": "max(1e-3, min(0.03, 1.5e-4 * |bbox_max - bbox_min|)), applied to each coordinate of the COM and the bbox",
    "basis": "solidcraft-checking template REL=2e-4 and its 1.5e-4 * size COM/bbox allowance (3x the documented 5e-5); the modeling reference reports analytic-vs-measured volume agreement of 0.001-0.01 %. Fixed before execution; not to be widened after a failure.",
    "expectation_consistency": "check_design.py recomputes every value below from the formulas and requires agreement within max(1e-6, 1e-9*|value|)"
  },
