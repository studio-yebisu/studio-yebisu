{
  "schema": "studio-yebisu/solidcraft-tray-expectations/1",
  "status": "Analytic expectations written before any execution. They are not tool measurements. Execution is PENDING.",
  "units": {"length": "mm", "area": "mm2", "volume": "mm3"},
  "body": "Tray",
  "fixed_parameters": {"wall": 3.0, "floor_thickness": 3.0},
  "default_parameters": {"width": 120.0, "depth": 80.0, "height": 18.0, "hole_diameter": 8.0},
